import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:flutter_local_notifications/flutter_local_notifications.dart';

// Assume flutterLocalNotificationsPlugin is accessible

class NativeSettingsSheet extends StatefulWidget {
  final Map<String, dynamic> times;
  const NativeSettingsSheet({Key? key, required this.times}) : super(key: key);

  @override
  State<NativeSettingsSheet> createState() => _NativeSettingsSheetState();
}

class _NativeSettingsSheetState extends State<NativeSettingsSheet> {
  bool _isLoading = true;
  bool _masterEnabled = false;
  
  // Prayer values
  Map<String, String> _prayerPrefs = {
    'fajr': 'adhan',
    'sunrise': 'beep',
    'makruhStart': 'beep',
    'makruhEnd': 'beep',
    'dhuhr': 'adhan',
    'asr': 'adhan',
    'maghrib': 'adhan',
    'isha': 'adhan',
  };

  // Dawah values
  bool _morningDawah = false;
  bool _maghribDawah = false;
  bool _sleepDawah = false;

  final Map<String, String> _prayerNames = {
    'fajr': 'Fajr / فجر',
    'sunrise': 'Sunrise / طلوعِ آفتاب',
    'makruhStart': 'Makruh Start / مکروہ شروع',
    'makruhEnd': 'Makruh End / مکروہ ختم',
    'dhuhr': 'Dhuhr / ظہر',
    'asr': 'Asr / عصر',
    'maghrib': 'Maghrib / مغرب',
    'isha': 'Isha / عشاء',
  };

  @override
  void initState() {
    super.initState();
    _loadPrefs();
  }

  Future<void> _loadPrefs() async {
    final prefs = await SharedPreferences.getInstance();
    setState(() {
      _masterEnabled = prefs.getBool('notifications_enabled') ?? false;
      
      for (String key in _prayerPrefs.keys) {
        _prayerPrefs[key] = prefs.getString('prayer_$key') ?? _prayerPrefs[key]!;
      }
      
      _morningDawah = prefs.getBool('dawah_morning_enabled') ?? false;
      _maghribDawah = prefs.getBool('dawah_maghrib_enabled') ?? false;
      _sleepDawah = prefs.getBool('dawah_sleep_enabled') ?? false;
      
      _isLoading = false;
    });
  }

  Future<void> _savePref(String key, String value) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('prayer_$key', value);
  }

  Future<void> _saveBool(String key, bool value) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setBool(key, value);
  }

  // Need to sync back to WebView
  // But wait, the WebView handles the cron logic. It reads from SharedPreferences when it loads!
  // OR we can just tell WebView to reload/sync via webViewController.runJavaScript('loadState(); render();')
}
