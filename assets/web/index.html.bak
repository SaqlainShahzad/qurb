    <!-- ============ DUAS OFFLINE LIBRARY (40 MASNOON DUAS) ============ -->
    <!-- ============ 1. TAB: KUTTUB KHANA / STITCH ISLAMIC DIGITAL LIBRARY ============ -->
    <div class="tab-panel" id="tab-library">
      <div class="library-wrap">

        <!-- Back Button -->
        <button class="back-row" data-action="tab:home" style="margin-bottom:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M15 6l-6 6 6 6" />
          </svg>
          <span data-i18n="backHome">واپس ہوم</span>
        </button>

        <!-- Library Header -->
        <div class="library-header-bar">
          <h1 class="library-main-title">
            <span> Library </span>
            <span style="font-size:1.1rem; color:rgba(255,255,255,0.6); font-weight:600;">• Library</span>
            <span class="library-badge-count" id="libBookCount">6</span>
          </h1>
        </div>

        <!-- Search Input -->
        <div class="library-search-container">
          <svg class="library-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" class="library-search-input" id="librarySearch"
            placeholder="Search documents... / کتاب تلاش کریں" autocomplete="off">
        </div>

        <!-- Stitch Drag-and-Drop Import Card -->
        <div class="stitch-import-card" id="stitchImportCard">
          <div class="stitch-import-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
          </div>
          <h3 class="stitch-import-title">Import PDF Document</h3>
          <p class="stitch-import-sub">Drag or select a PDF file to add it to your Islamic library for offline reading.
          </p>
          <button type="button" class="stitch-btn-browse" id="libImportPdfBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Browse Files</span>
          </button>
          <input type="file" id="libFileInput" accept="application/pdf" style="display:none;">
        </div>

        <!-- Recently Read Carousel -->
        <div class="stitch-recent-section" id="stitchRecentSection" style="display:none;">
          <div class="stitch-section-title">
            <span>Recently Read</span>
          </div>
          <div class="stitch-recent-scroll" id="stitchRecentScroll"></div>
        </div>

        <!-- Category Filter Chips -->
        <div class="stitch-section-title">
          <span>All Documents</span>
        </div>
        <div class="stitch-filter-chips" id="libraryCategoryFilters"></div>

        <!-- All Books Grid -->
        <div class="stitch-books-grid" id="libraryBooksGrid"></div>

      </div>
    </div>

    <!-- ============ 2. TAB: DUA (40 MASNOON DUAS SLIDING CAROUSEL) ============ -->
    <div class="tab-panel" id="tab-duas">
      <div class="duas-wrap">
        <button class="back-row" data-action="tab:home" style="margin-bottom:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M15 6l-6 6 6 6" />
          </svg>
          <span data-i18n="backHome">واپس ہوم</span>
        </button>

        <div class="duas-header">
          <h2>۴۰ مسنون دعائیں</h2>
          <p>قرآن و سنت کی مستند دعائیں — عربی، تلفظ، اردو و انگریزی ترجمہ مع حوالہ جات</p>
        </div>

        <div class="duas-filter-chips" id="duasCategoryFilters"></div>
        <input type="search" class="duas-search" id="duasSearch" placeholder="دعا تلاش کریں... (نام، موضوع یا متن)"
          autocomplete="off">

        <div id="duasContainer"></div>
      </div>
    </div>

    <!-- ============ 3. TAB: QURAN (القرآن الكريم — كامل 114 سورة) ============ -->
    <div class="tab-panel" id="tab-hadith">
      <div class="hadith-wrap">
        <button class="back-row" data-action="tab:home" style="margin-bottom:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M15 6l-6 6 6 6" />
          </svg>
          <span data-i18n="backHome">واپس ہوم</span>
        </button>

        <div class="hadith-header">
          <h2>الأربعون النووية — 40 احادیثِ نبویہ</h2>
          <p>امام یحییٰ بن شرف النوویؒ کی جامع مستند احادیث مع اردو و انگریزی ترجمہ</p>
        </div>

        <div class="library-filters" id="hadithCategoryFilters"></div>
        <input type="search" class="hadith-search" id="hadithSearch"
          placeholder="حدیث تلاش کریں... (متن، ترجمہ یا حوالہ)" autocomplete="off">
        <div class="hadith-list" id="hadithList"></div>
      </div>
    </div>

    <!-- ============ ABOUT US ============ -->
    <!-- ============ ZIKR BOOK ============ -->
    <div class="tab-panel" id="tab-zikr">
      <div class="zikr-wrap">
        <button class="back-row" data-action="tab:home" style="margin-bottom:12px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M15 6l-6 6 6 6" />
          </svg>
          <span>واپس ہوم</span>
        </button>

        <section class="zikr-hero">
          <div class="zikr-hero-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M7 4.5h8.5L19 8v11.5a1 1 0 0 1-1 1H7a2 2 0 0 1-2-2V6.5a2 2 0 0 1 2-2Z" />
              <path d="M15 4.5V8h4M8 11h8M8 14h8M8 17h5" />
            </svg>
          </div>
          <h2>صبح و شام کے اذکار</h2>
          <p>کتاب ڈاؤن لوڈ کریں، ایپ میں محفوظ کریں اور پھر صفحات کی صورت میں آف لائن بھی پڑھیں۔</p>
        </section>

        <section class="zikr-book-card">
          <div class="zikr-book-cover">
            <div class="zikr-book-cover-inner">
              <div class="zikr-book-cover-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v18H7.5A2.5 2.5 0 0 0 5 22.5" />
                  <path d="M5 4.5v16M9 7h6M9 10.5h7M9 14h6" />
                </svg>
              </div>
              <div class="zikr-book-title">صبح و شام اذکار</div>
              <div class="zikr-book-meta">8 صفحات • آف لائن مطالعہ</div>
            </div>
          </div>

          <button type="button" class="zikr-download-btn" id="zikrDownloadBtn">
            کتاب ڈاؤن لوڈ کرکے ایپ میں محفوظ کریں
          </button>
          <div class="zikr-download-status" id="zikrDownloadStatus"></div>
          <div class="zikr-offline-badge" id="zikrOfflineBadge">✓ کتاب ایپ میں محفوظ ہے — آف لائن پڑھ سکتے ہیں</div>
        </section>

        <section class="zikr-viewer" id="zikrViewer" aria-label="صبح و شام اذکار">
          <div class="zikr-viewer-top">
            <div class="zikr-viewer-title">کتاب پڑھیں</div>
            <div class="zikr-page-count" id="zikrPageCount">1 / 8</div>
          </div>
          <div class="zikr-slide" id="zikrSlide">
            <img id="zikrPageImage" alt="صبح و شام اذکار کا صفحہ" draggable="false">
          </div>
          <div class="zikr-progress"><span id="zikrProgress"></span></div>
          <div class="zikr-controls">
            <button type="button" class="zikr-nav-btn" id="zikrPrev" aria-label="پچھلا صفحہ">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 6l-6 6 6 6" />
              </svg>
            </button>
            <div class="zikr-page-pill" id="zikrPagePill">صفحہ 1</div>
            <button type="button" class="zikr-nav-btn" id="zikrNext" aria-label="اگلا صفحہ">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 6l6 6-6 6" />
              </svg>
            </button>
          </div>
          <div class="zikr-tip">صفحہ بدلنے کے لیے نیچے کے بٹن استعمال کریں یا صفحے پر بائیں/دائیں swipe کریں۔</div>
        </section>
      </div>
    </div>

    <!-- ============ MANZIL ============ -->
    <div class="tab-panel" id="tab-manzil">
      <div class="manzil-wrap">
        <button class="back-row" data-action="tab:home" style="margin-bottom:12px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M15 6l-6 6 6 6" />
          </svg>
          <span>واپس ہوم</span>
        </button>

        <div class="manzil-header">
          <h2>مَنزِل</h2>
          <p>آیاتِ قرآنِ کریم — تلاوت و حفاظت کے لیے</p>
          <div class="manzil-font-controls" role="group" aria-label="قرآنی متن کا فونٹ سائز">
            <button type="button" class="manzil-font-btn" data-manzil-font="24" aria-label="فونٹ چھوٹا کریں">A−</button>
            <button type="button" class="manzil-font-btn active" data-manzil-font="27"
              aria-label="درمیانہ فونٹ">A</button>
            <button type="button" class="manzil-font-btn" data-manzil-font="30" aria-label="فونٹ بڑا کریں">A+</button>
          </div>
        </div>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْفَاتِحَةِ</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ <span class="manzil-ayah-num">٢</span></div>
          <div class="manzil-ayah">الرَّحْمَٰنِ الرَّحِيمِ <span class="manzil-ayah-num">٣</span></div>
          <div class="manzil-ayah">مَالِكِ يَوْمِ الدِّينِ <span class="manzil-ayah-num">٤</span></div>
          <div class="manzil-ayah">إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ <span class="manzil-ayah-num">٥</span></div>
          <div class="manzil-ayah">اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ <span class="manzil-ayah-num">٦</span></div>
          <div class="manzil-ayah">صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا
            الضَّالِّينَ <span class="manzil-ayah-num">٧</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْبَقَرَةِ — ١–٥</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">الم <span class="manzil-ayah-num">١</span></div>
          <div class="manzil-ayah">ذَٰلِكَ الْكِتَابُ لَا رَيْبَ ۛ فِيهِ ۛ هُدًى لِّلْمُتَّقِينَ <span
              class="manzil-ayah-num">٢</span></div>
          <div class="manzil-ayah">الَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ وَيُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ
            يُنفِقُونَ <span class="manzil-ayah-num">٣</span></div>
          <div class="manzil-ayah">وَالَّذِينَ يُؤْمِنُونَ بِمَا أُنزِلَ إِلَيْكَ وَمَا أُنزِلَ مِن قَبْلِكَ
            وَبِالْآخِرَةِ هُمْ يُوقِنُونَ <span class="manzil-ayah-num">٤</span></div>
          <div class="manzil-ayah">أُولَٰئِكَ عَلَىٰ هُدًى مِّن رَّبِّهِمْ ۖ وَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ <span
              class="manzil-ayah-num">٥</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْبَقَرَةِ — ١٦٣، ٢٥٥–٢٥٧، ٢٨٤–٢٨٦</h3>
          <div class="manzil-ayah">وَإِلَٰهُكُمْ إِلَٰهٌ وَاحِدٌ ۖ لَّا إِلَٰهَ إِلَّا هُوَ الرَّحْمَٰنُ الرَّحِيمُ
            <span class="manzil-ayah-num">١٦٣</span>
          </div>
          <div class="manzil-ayah">اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا
            نَوْمٌ ۚ لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا
            بِإِذْنِهِ ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ
            إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ
            الْعَلِيُّ الْعَظِيمُ <span class="manzil-ayah-num">٢٥٥</span></div>
          <div class="manzil-ayah">لَا إِكْرَاهَ فِي الدِّينِ ۖ قَد تَّبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ ۚ فَمَن يَكْفُرْ
            بِالطَّاغُوتِ وَيُؤْمِن بِاللَّهِ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَىٰ لَا انفِصَامَ لَهَا ۗ
            وَاللَّهُ سَمِيعٌ عَلِيمٌ <span class="manzil-ayah-num">٢٥٦</span></div>
          <div class="manzil-ayah">اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُم مِّنَ الظُّلُمَاتِ إِلَى النُّورِ ۖ
            وَالَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُم مِّنَ النُّورِ إِلَى الظُّلُمَاتِ ۗ
            أُولَٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ <span class="manzil-ayah-num">٢٥٧</span></div>
          <div class="manzil-ayah">لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ وَإِن تُبْدُوا مَا فِي
            أَنفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُم بِهِ اللَّهُ ۖ فَيَغْفِرُ لِمَن يَشَاءُ وَيُعَذِّبُ مَن يَشَاءُ ۗ
            وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ <span class="manzil-ayah-num">٢٨٤</span></div>
          <div class="manzil-ayah">آمَنَ الرَّسُولُ بِمَا أُنزِلَ إِلَيْهِ مِن رَّبِّهِ وَالْمُؤْمِنُونَ ۚ كُلٌّ آمَنَ
            بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِّن رُّسُلِهِ ۚ وَقَالُوا
            سَمِعْنَا وَأَطَعْنَا ۖ غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ <span class="manzil-ayah-num">٢٨٥</span>
          </div>
          <div class="manzil-ayah">لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا ۚ لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا
            اكْتَسَبَتْ ۗ رَبَّنَا لَا تُؤَاخِذْنَا إِن نَّسِينَا أَوْ أَخْطَأْنَا ۚ رَبَّنَا وَلَا تَحْمِلْ عَلَيْنَا
            إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِن قَبْلِنَا ۚ رَبَّنَا وَلَا تُحَمِّلْنَا مَا لَا طَاقَةَ لَنَا
            بِهِ ۖ وَاعْفُ عَنَّا وَاغْفِرْ لَنَا وَارْحَمْنَا ۚ أَنتَ مَوْلَانَا فَانصُرْنَا عَلَى الْقَوْمِ
            الْكَافِرِينَ <span class="manzil-ayah-num">٢٨٦</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ آلِ عِمْرَانَ — ١٨، ٢٦–٢٧</h3>
          <div class="manzil-ayah">شَهِدَ اللَّهُ أَنَّهُ لَا إِلَٰهَ إِلَّا هُوَ وَالْمَلَائِكَةُ وَأُولُو الْعِلْمِ
            قَائِمًا بِالْقِسْطِ ۚ لَا إِلَٰهَ إِلَّا هُوَ الْعَزِيزُ الْحَكِيمُ <span class="manzil-ayah-num">١٨</span>
          </div>
          <div class="manzil-ayah">قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ تُؤْتِي الْمُلْكَ مَن تَشَاءُ وَتَنزِعُ الْمُلْكَ
            مِمَّن تَشَاءُ وَتُعِزُّ مَن تَشَاءُ وَتُذِلُّ مَن تَشَاءُ ۖ بِيَدِكَ الْخَيْرُ ۖ إِنَّكَ عَلَىٰ كُلِّ
            شَيْءٍ قَدِيرٌ <span class="manzil-ayah-num">٢٦</span></div>
          <div class="manzil-ayah">تُولِجُ اللَّيْلَ فِي النَّهَارِ وَتُولِجُ النَّهَارَ فِي اللَّيْلِ ۖ وَتُخْرِجُ
            الْحَيَّ مِنَ الْمَيِّتِ وَتُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ ۖ وَتَرْزُقُ مَن تَشَاءُ بِغَيْرِ حِسَابٍ <span
              class="manzil-ayah-num">٢٧</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْأَعْرَافِ — ٥٤–٥٦</h3>
          <div class="manzil-ayah">إِنَّ رَبَّكُمُ اللَّهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ
            ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ ۖ يُغْشِي اللَّيْلَ النَّهَارَ يَطْلُبُهُ حَثِيثًا وَالشَّمْسَ وَالْقَمَرَ
            وَالنُّجُومَ مُسَخَّرَاتٍ بِأَمْرِهِ ۗ أَلَا لَهُ الْخَلْقُ وَالْأَمْرُ ۗ تَبَارَكَ اللَّهُ رَبُّ
            الْعَالَمِينَ <span class="manzil-ayah-num">٥٤</span></div>
          <div class="manzil-ayah">ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً ۚ إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ <span
              class="manzil-ayah-num">٥٥</span></div>
          <div class="manzil-ayah">وَلَا تُفْسِدُوا فِي الْأَرْضِ بَعْدَ إِصْلَاحِهَا وَادْعُوهُ خَوْفًا وَطَمَعًا ۚ
            إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِّنَ الْمُحْسِنِينَ <span class="manzil-ayah-num">٥٦</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْإِسْرَاءِ — ١١٠–١١١</h3>
          <div class="manzil-ayah">قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا الرَّحْمَٰنَ ۖ أَيًّا مَّا تَدْعُوا فَلَهُ
            الْأَسْمَاءُ الْحُسْنَىٰ ۚ وَلَا تَجْهَرْ بِصَلَاتِكَ وَلَا تُخَافِتْ بِهَا وَابْتَغِ بَيْنَ ذَٰلِكَ
            سَبِيلًا <span class="manzil-ayah-num">١١٠</span></div>
          <div class="manzil-ayah">وَقُلِ الْحَمْدُ لِلَّهِ الَّذِي لَمْ يَتَّخِذْ وَلَدًا وَلَمْ يَكُن لَّهُ شَرِیکٌ
            فِي الْمُلْكِ وَلَمْ يَكُن لَّهُ وَلِيٌّ مِّنَ الذُّلِّ وَكَبِّرْهُ تَكْبِيرًا <span
              class="manzil-ayah-num">١١١</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْمُؤْمِنُونَ — ١١٥–١١٨</h3>
          <div class="manzil-ayah">أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَأَنَّكُمْ إِلَيْنَا لَا تُرْجَعُونَ
            <span class="manzil-ayah-num">١١٥</span>
          </div>
          <div class="manzil-ayah">فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ ۖ لَا إِلَٰهَ إِلَّا هُوَ رَبُّ الْعَرْشِ
            الْكَرِيمِ <span class="manzil-ayah-num">١١٦</span></div>
          <div class="manzil-ayah">وَمَن يَدْعُ مَعَ اللَّهِ إِلَٰهًا آخَرَ لَا بُرْهَانَ لَهُ بِهِ ۙ فَإِنَّمَا
            حِسَابُهُ عِندَ رَبِّهِ ۚ إِنَّهُ لَا يُفْلِحُ الْكَافِرُونَ <span class="manzil-ayah-num">١١٧</span></div>
          <div class="manzil-ayah">وَقُل رَّبِّ اغْفِرْ وَارْحَمْ وَأَنتَ خَيْرُ الرَّاحِمِينَ <span
              class="manzil-ayah-num">١١٨</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الصَّافَّاتِ — ١–١١</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">وَالصَّافَّاتِ صَفًّا <span class="manzil-ayah-num">١</span></div>
          <div class="manzil-ayah">فَالزَّاجِرَاتِ زَجْرًا <span class="manzil-ayah-num">٢</span></div>
          <div class="manzil-ayah">فَالتَّالِيَاتِ ذِكْرًا <span class="manzil-ayah-num">٣</span></div>
          <div class="manzil-ayah">إِنَّ إِلَٰهَكُمْ لَوَاحِدٌ <span class="manzil-ayah-num">٤</span></div>
          <div class="manzil-ayah">رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ <span
              class="manzil-ayah-num">٥</span></div>
          <div class="manzil-ayah">إِنَّا زَيَّنَّا السَّمَاءَ الدُّنْيَا بِزِينَةٍ الْكَوَاكِبِ <span
              class="manzil-ayah-num">٦</span></div>
          <div class="manzil-ayah">وَحِفْظًا مِّن كُلِّ شَيْطَانٍ مَّارِدٍ <span class="manzil-ayah-num">٧</span></div>
          <div class="manzil-ayah">لَا يَسَّمَّعُونَ إِلَى الْمَلَإِ الْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ <span
              class="manzil-ayah-num">٨</span></div>
          <div class="manzil-ayah">دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ <span class="manzil-ayah-num">٩</span></div>
          <div class="manzil-ayah">إِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَأَتْبَعَهُ شِهَابٌ ثَاقِبٌ <span
              class="manzil-ayah-num">١٠</span></div>
          <div class="manzil-ayah">فَاسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَا ۚ إِنَّا خَلَقْنَاهُم مِّن
            طِينٍ لَّازِبٍ <span class="manzil-ayah-num">١١</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الرَّحْمَٰنِ — ٣٣–٤٠</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">يَا مَعْشَرَ الْجِنِّ وَالْإِنسِ إِنِ اسْتَطَعْتُمْ أَن تَنفُذُوا مِنْ أَقْطَارِ
            السَّمَاوَاتِ وَالْأَرْضِ فَانفُذُوا ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَانٍ <span
              class="manzil-ayah-num">٣٣</span></div>
          <div class="manzil-ayah">فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ <span class="manzil-ayah-num">٣٤</span>
          </div>
          <div class="manzil-ayah">يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ <span
              class="manzil-ayah-num">٣٥</span></div>
          <div class="manzil-ayah">فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ <span class="manzil-ayah-num">٣٦</span>
          </div>
          <div class="manzil-ayah">فَإِذَا انشَقَّتِ السَّمَاءُ فَكَانَتْ وَرْدَةً كَالدِّهَانِ <span
              class="manzil-ayah-num">٣٧</span></div>
          <div class="manzil-ayah">فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ <span class="manzil-ayah-num">٣٨</span>
          </div>
          <div class="manzil-ayah">فَيَوْمَئِذٍ لَّا يُسْأَلُ عَن ذَنبِهِ إِنسٌ وَلَا جَانٌّ <span
              class="manzil-ayah-num">٣٩</span></div>
          <div class="manzil-ayah">فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ <span class="manzil-ayah-num">٤٠</span>
          </div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْحَشْرِ — ٢١–٢٤</h3>
          <div class="manzil-ayah">لَوْ أَنزَلْنَا هَٰذَا الْقُرْآنَ عَلَىٰ جَبَلٍ لَّرَأَيْتَهُ خَاشِعًا مُّتَصَدِّعًا
            مِّنْ خَشْيَةِ اللَّهِ ۚ وَتِلْكَ الْأَمْثَالُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ <span
              class="manzil-ayah-num">٢١</span></div>
          <div class="manzil-ayah">هُوَ اللَّهُ الَّذِي لَا إِلَٰهَ إِلَّا هُوَ ۖ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ ۖ
            هُوَ الرَّحْمَٰنُ الرَّحِيمُ <span class="manzil-ayah-num">٢٢</span></div>
          <div class="manzil-ayah">هُوَ اللَّهُ الَّذِي لَا إِلَٰهَ إِلَّا هُوَ الْمَلِكُ الْقُدُّوسُ السَّلَامُ
            الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ ۚ سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ <span
              class="manzil-ayah-num">٢٣</span></div>
          <div class="manzil-ayah">هُوَ اللَّهُ الْخَالِقُ الْبَارِئُ الْمُصَوِّرُ ۖ لَهُ الْأَسْمَاءُ الْحُسْنَىٰ ۚ
            يُسَبِّحُ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ ۖ وَهُوَ الْعَزِيزُ الْحَكِيمُ <span
              class="manzil-ayah-num">٢٤</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْجِنِّ — ١–٤</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">قُلْ أُوحِيَ إِلَيَّ أَنَّهُ اسْتَمَعَ نَفَرٌ مِّنَ الْجِنِّ فَقَالُوا إِنَّا
            سَمِعْنَا قُرْآنًا عَجَبًا <span class="manzil-ayah-num">١</span></div>
          <div class="manzil-ayah">يَهْدِي إِلَى الرُّشْدِ فَآمَنَّا بِهِ ۖ وَلَن نُّشْرِكَ بِرَبِّنَا أَحَدًا <span
              class="manzil-ayah-num">٢</span></div>
          <div class="manzil-ayah">وَأَنَّهُ تَعَالَىٰ جَدُّ رَبِّنَا مَا اتَّخَذَ صَاحِبَةً وَلَا وَلَدًا <span
              class="manzil-ayah-num">٣</span></div>
          <div class="manzil-ayah">وَأَنَّهُ كَانَ يَقُولُ سَفِيهُنَا عَلَى اللَّهِ شَطَطًا <span
              class="manzil-ayah-num">٤</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْكَافِرُونَ</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">قُلْ يَا أَيُّهَا الْكَافِرُونَ <span class="manzil-ayah-num">١</span></div>
          <div class="manzil-ayah">لَا أَعْبُدُ مَا تَعْبُدُونَ <span class="manzil-ayah-num">٢</span></div>
          <div class="manzil-ayah">وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ <span class="manzil-ayah-num">٣</span></div>
          <div class="manzil-ayah">وَلَا أَنَا عَابِدٌ مَّا عَبَدتُّمْ <span class="manzil-ayah-num">٤</span></div>
          <div class="manzil-ayah">وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ <span class="manzil-ayah-num">٥</span></div>
          <div class="manzil-ayah">لَكُمْ دِينُكُمْ وَلِيَ دِينِ <span class="manzil-ayah-num">٦</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْإِخْلَاصِ</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">قُلْ هُوَ اللَّهُ أَحَدٌ <span class="manzil-ayah-num">١</span></div>
          <div class="manzil-ayah">اللَّهُ الصَّمَدُ <span class="manzil-ayah-num">٢</span></div>
          <div class="manzil-ayah">لَمْ يَلِدْ وَلَمْ يُولَدْ <span class="manzil-ayah-num">٣</span></div>
          <div class="manzil-ayah">وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ <span class="manzil-ayah-num">٤</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ الْفَلَقِ</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ <span class="manzil-ayah-num">١</span></div>
          <div class="manzil-ayah">مِن شَرِّ مَا خَلَقَ <span class="manzil-ayah-num">٢</span></div>
          <div class="manzil-ayah">وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ <span class="manzil-ayah-num">٣</span></div>
          <div class="manzil-ayah">وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ <span class="manzil-ayah-num">٤</span></div>
          <div class="manzil-ayah">وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ <span class="manzil-ayah-num">٥</span></div>
        </section>

        <section class="manzil-section">
          <h3 class="manzil-section-title">سُورَةُ النَّاسِ</h3>
          <div class="manzil-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
          <div class="manzil-ayah">قُلْ أَعُوذُ بِرَبِّ النَّاسِ <span class="manzil-ayah-num">١</span></div>
          <div class="manzil-ayah">مَلِكِ النَّاسِ <span class="manzil-ayah-num">٢</span></div>
          <div class="manzil-ayah">إِلَٰهِ النَّاسِ <span class="manzil-ayah-num">٣</span></div>
          <div class="manzil-ayah">مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ <span class="manzil-ayah-num">٤</span></div>
          <div class="manzil-ayah">الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ <span class="manzil-ayah-num">٥</span></div>
          <div class="manzil-ayah">مِنَ الْجِنَّةِ وَالنَّاسِ <span class="manzil-ayah-num">٦</span></div>
        </section>
      </div>
    </div>

    <div class="tab-panel" id="tab-about">
      <button class="back-row" data-action="tab:home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M15 6l-6 6 6 6" />
        </svg>
        <span data-i18n="backHome">واپس ہوم</span>
      </button>

      <div class="about-card">
        <div class="about-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
            stroke-linejoin="round">
            <circle cx="12" cy="8" r="3.8" />
            <path d="M4 20.5c0-4.1 3.6-7.4 8-7.4s8 3.3 8 7.4" />
          </svg>
        </div>
        <h2 class="about-name" data-i18n="aboutName">مفتی معاذ ہارون</h2>
        <p class="about-tag" data-i18n="aboutTag">پاکستانی عالمِ دین، مصنف و ویب ڈویلپر</p>
      </div>

      <div class="about-body">
        <p data-i18n="aboutP1">مفتی معاذ ہارون ایک پاکستانی عالمِ دین اور مصنف ہیں۔ آپ نے قومی سطح کے قرأت مقابلے میں
          کامیابی حاصل کی جس کے صلے میں عمرہ کا ٹکٹ بطور انعام دیا گیا۔</p>

        <p data-i18n="aboutP2">صرف 12 سال کی عمر میں، بغیر ناظرہ کی منزل میں وقت گزارے، محض 2 سال میں حفظِ قرآن مکمل
          کیا۔ اس کے بعد 8 سالہ درسِ نظامی کی تکمیل کی اور تخصص فی الفقہ کی سند حاصل کی۔ جامعہ مظاہرِ علوم (JMU) سے سندِ
          فراغت و افتاء، نیز عربی ادب میں ماسٹرز کی ڈگری حاصل کی۔</p>

        <p data-i18n="aboutP3">آپ کو تصوف سے خاص شغف ہے اور سلسلہ نقشبندیہ سراجیہ میں شیخ کبیر پیر بارک اللہ صاحب سے
          اجازت حاصل ہے۔</p>

        <p data-i18n="aboutP4">مفتی صاحب کتاب <b>"خلاصۃ القرآن لابن ہارون"</b> کے مصنف ہیں، اور جامعہ تعلیم القرآن،
          خیبرپختونخوا میں تدریس سے وابستہ ہیں۔ ایک ماہر کمپیوٹر پروگرامر اور ویب ڈویلپر بھی ہیں۔ سوشل میڈیا پر ہزاروں
          پیروکار آپ کے سادہ اور دل نشین انداز کے گرویدہ ہیں، خصوصاً آپ کی معروف سیریز <b>"40 مختصر احادیث"</b> کو بے حد
          پذیرائی ملی۔</p>

        <div class="about-quote" data-i18n="aboutQuote">"امر بالمعروف و نہی عن المنکر" کا سادہ مگر پرمغز پیغام لے کر ملک
          بھر اور دنیا بھر میں پھیلانا آپ کا نصب العین ہے۔</div>
      </div>

      <div class="about-links">
        <a class="about-link" href="https://muftimaazharoon.com" target="_blank" rel="noopener"
          data-i18n="linkWebsite">ویب سائٹ: muftimaazharoon.com</a>
        <a class="about-link" href="https://facebook.com/muftimaazharoon" target="_blank" rel="noopener"
          data-i18n="linkFacebook">فیس بک</a>
        <a class="about-link" href="https://instagram.com/muftimaazharoon" target="_blank" rel="noopener"
          data-i18n="linkInstagram">انسٹاگرام</a>
        <a class="about-link" href="https://youtube.com/muftimaazharoon" target="_blank" rel="noopener"
          data-i18n="linkYoutube">یوٹیوب</a>
      </div>
    </div>

