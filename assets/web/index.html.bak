    <!-- QIBLA AR FINDER -->
    <div class="tab-panel" id="tab-qibla">
      <div class="qibla-wrap">
        <div class="qibla-top">
          <button class="qibla-back" id="qiblaBackBtn" type="button" aria-label="Back">‹</button>
          <div class="qibla-heading">
            <div class="qibla-title" data-i18n="qiblaTitle">قبلہ رخ</div>
            <div class="qibla-subtitle" data-i18n="qiblaSubtitle">کیمرہ کے ذریعے خانۂ کعبہ کی سمت معلوم کریں</div>
          </div>
        </div>
        <div class="qibla-card">
          <div class="qibla-mode-row">
            <button class="qibla-mode active" id="qiblaArMode" type="button" data-i18n="qiblaArMode">🌍 AR قبلہ</button>
            <button class="qibla-mode" id="qiblaCompassMode" type="button" data-i18n="qiblaCompassMode">🧭
              Compass</button>
          </div>
          <div class="qibla-ar-stage show" id="qiblaArStage">
            <video class="qibla-video" id="qiblaVideo" playsinline muted webkit-playsinline></video>
            <div class="qibla-ar-shade"></div>
            <div class="qibla-ar-top">
              <span class="qibla-ar-badge" data-i18n="qiblaArBadge">LIVE AR QIBLA</span>
              <span class="qibla-ar-badge" id="qiblaArHeading">—°</span>
            </div>
            <div class="qibla-ar-target"></div>
            <div class="qibla-3d-wrap" id="qibla3dWrap">
              <model-viewer id="qiblaModel" data-src="./kaaba.glb" alt="3D Kaaba" camera-controls auto-rotate
                interaction-prompt="none" shadow-intensity="1"></model-viewer>
            </div>
            <div class="qibla-ar-bottom">
              <div class="qibla-ar-instruction" id="qiblaArInstruction" data-i18n="qiblaArStartText">کیمرہ شروع کریں اور
                فون کو آہستہ آہستہ گھمائیں۔</div>
              <div class="qibla-ar-bearing" id="qiblaArBearing">Qibla —°</div>
            </div>
          </div>
          <div class="qibla-compass-panel" id="qiblaCompassPanel">
            <div class="qibla-compass" id="qiblaCompass">
              <div class="qibla-dir" id="qiblaDial">
                <b class="n">N</b>
                <b class="e">E</b>
                <b class="s">S</b>
                <b class="w">W</b>
              </div>
              <div class="qibla-arrow" id="qiblaArrow"></div>
              <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:24px;z-index:4">🕋
              </div>
            </div>
            <div class="qibla-degree" id="qiblaDegrees">—°</div>
            <div class="qibla-direction" id="qiblaDirection">—</div>
          </div>

          <!-- Figure-8 Calibration & Sensor Fallback Banner -->
          <div class="qibla-cal-banner hidden" id="qiblaCalBanner">
            <span class="qibla-cal-icon">♾️</span>
            <div class="qibla-cal-text" id="qiblaCalText" data-i18n="qiblaCalibrateText">فون کو ہوا میں 8 کی شکل میں
              گھمائیں، پھر سیدھا رکھیں۔</div>
            <button type="button" class="qibla-cal-btn-mini" id="qiblaCalBannerBtn"
              data-i18n="qiblaCalibrate">کیلیبریٹ</button>
          </div>

          <div class="qibla-status" id="qiblaStatus" data-i18n="qiblaStatusStart">مقام اور کیمرہ/کمپاس کی اجازت درکار
            ہے۔</div>
          <button class="qibla-btn" id="qiblaStartBtn" type="button" data-i18n="qiblaStart">AR Qibla شروع کریں</button>
          <button class="qibla-btn secondary" id="qiblaCalibrateBtn" type="button" data-i18n="qiblaCalibrate">کمپاس
            کیلیبریٹ کریں</button>
          <button class="qibla-btn secondary" id="qiblaNativeBtn" type="button" style="display:none;"
            data-i18n="qiblaOpenNative">📱 نیٹِو کمپاس کھولیں (Native Compass)</button>

          <div class="qibla-info">
            <div class="qibla-info-box">
              <div class="qibla-info-label" data-i18n="qiblaBearingLabel">قبلہ کا زاویہ</div>
              <div class="qibla-info-value" id="qiblaBearing">—</div>
            </div>
            <div class="qibla-info-box">
              <div class="qibla-info-label" data-i18n="qiblaLocationLabel">آپ کا مقام</div>
              <div class="qibla-info-value" id="qiblaCoords">—</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ============ SETTINGS ============ -->
    <div class="tab-panel" id="tab-settings">
      <div class="settings-menu">
        <div class="settings-menu-list">

          <!-- Prayer Notifications -->
          <section class="settings-menu-item" id="settingsMenuNotifications">

            <div class="settings-menu-panel" id="settingsNotificationsPanel">
              <div class="settings-menu-panel-inner">
                <div class="notification-settings" id="notification-container" data-theme="dark">
                  <!-- Top Header & Theme Mode -->
                  <div class="notif-header">
                    <h2 class="notif-title" data-i18n="notifSettingsTitle">Notification Settings</h2>
                    <div class="theme-segmented-control">
                      <button class="theme-btn" id="lightThemeBtn" type="button" onclick="setNotifTheme('light')">Light
                        Mode</button>
                      <button class="theme-btn active" id="darkThemeBtn" type="button"
                        onclick="setNotifTheme('dark')">Dark Mode</button>
                    </div>
                  </div>

                  <!-- Master Control Card -->
                  <div class="notif-card master-card">
                    <div class="notif-card-text">
                      <strong data-i18n="notifMasterTitle">Master Prayer Alerts</strong>
                      <span data-i18n="notifMasterSub">Toggle all Adhan and prayer reminders.</span>
                    </div>
                    <label class="notif-switch">
                      <input id="notifMaster" type="checkbox" onchange="window.handleNotificationSettingChange(this)"
                        checked>
                      <span class="notif-slider"></span>
                    </label>
                  </div>

                  <!-- Individual Prayer Notifications -->
                  <div class="notif-section-title" data-i18n="notifIndivTitle">Individual Prayer Notifications</div>
                  <div class="notif-card indiv-card">

                    <div class="notif-row">
                      <div class="notif-row-left">
                        <span class="notif-icon">☾</span><span class="notif-name" data-i18n="fajr">Fajr</span>
                      </div>
                      <div class="notif-row-right">
                        <label class="notif-switch small"><input type="checkbox" class="indiv-toggle" data-kind="prayer"
                            data-key="fajr" onchange="window.handleNotificationSettingChange(this)" checked><span
                            class="notif-slider"></span></label>
                        <select class="notif-select" data-kind="prayer" data-key="fajr"
                          onchange="window.handleNotificationSettingChange(this)">
                          <option value="adhan">Full Adhan</option>
                          <option value="takbeer">Soft Takbeer</option>
                          <option value="beep">Simple Beep</option>
                          <option value="vibrate">Vibration Only</option>
                          <option value="mute">Mute</option>
                        </select>
                      </div>
                    </div>

                    <div class="notif-row">
                      <div class="notif-row-left">
                        <span class="notif-icon">☼</span><span class="notif-name" data-i18n="dhuhr">Dhuhr</span>
                      </div>
