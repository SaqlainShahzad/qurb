                <td>5:47</td>
                <td>7:18</td>
                <td>12:15</td>
                <td>3:33</td>
                <td>5:15</td>
                <td>6:41</td>
              </tr>
              <tr data-day="3">
                <td class="daynum">3</td>
                <td>5:47</td>
                <td>7:18</td>
                <td>12:15</td>
                <td>3:34</td>
                <td>5:16</td>
                <td>6:42</td>
              </tr>
              <tr data-day="4">
                <td class="daynum">4</td>
                <td>5:47</td>
                <td>7:18</td>
                <td>12:16</td>
                <td>3:34</td>
                <td>5:17</td>
                <td>6:43</td>
              </tr>
              <tr data-day="5">
                <td class="daynum">5</td>
                <td>5:47</td>
                <td>7:18</td>
                <td>12:16</td>
                <td>3:35</td>
                <td>5:18</td>
                <td>6:43</td>
              </tr>
              <tr data-day="6">
                <td class="daynum">6</td>
                <td>5:48</td>
                <td>7:18</td>
                <td>12:16</td>
                <td>3:36</td>
                <td>5:19</td>
                <td>6:44</td>
              </tr>
              <tr data-day="7">
                <td class="daynum">7</td>
                <td>5:48</td>
                <td>7:18</td>
                <td>12:17</td>
