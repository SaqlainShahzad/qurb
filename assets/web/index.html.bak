                          data-key="morning" onchange="window.handleNotificationSettingChange(this)" checked><span
                          class="notif-slider"></span></label>
                    </div>

                  </div>

                  <div class="notif-test-wrapper">
                    <button class="notif-test-btn test-btn" id="testNotificationBtn" type="button"
                      onclick="window.triggerTestNotification(event)">
                      🔔 Test Notification
                    </button>
                  </div>
                </div>

                <script>
                  function setNotifTheme(mode) {
                    var container = document.getElementById('notification-container');
                    var darkBtn = document.getElementById('darkThemeBtn');
                    var lightBtn = document.getElementById('lightThemeBtn');
                    var quranReader = null;

                    var activeMode = (mode === 'light') ? 'light' : 'dark';

                    // Save to localStorage
                    try {
                      localStorage.setItem('app_theme_preference', activeMode);
                    } catch (e) { }

                    // Apply data-theme attribute
                    if (container) container.setAttribute('data-theme', activeMode);
                    if (quranReader) quranReader.setAttribute('data-theme', activeMode);

                    // Update button UI
                    if (activeMode === 'light') {
                      if (lightBtn) lightBtn.classList.add('active');
                      if (darkBtn) darkBtn.classList.remove('active');
                    } else {
                      if (darkBtn) darkBtn.classList.add('active');
                      if (lightBtn) lightBtn.classList.remove('active');
                    }

                    if (typeof appThemeState !== 'undefined' && appThemeState) {
                      appThemeState.theme = activeMode;
                    }
                  }

                  // Auto-apply saved theme on initial script execution
                  try {
                    var savedTheme = localStorage.getItem('app_theme_preference') || 'dark';
                    setNotifTheme(savedTheme);
                  } catch (e) { }

                  function updatePreAdhan(val) {
                    document.getElementById('preAdhanLabel').textContent = val + ' minutes before';
                    if (!window.state) window.state = {};
                    if (!window.state.special) window.state.special = {};
                    window.state.special.preAdhanMinutes = parseInt(val);
                  }

                  document.getElementById('notifMaster').addEventListener('change', function (e) {
                    var isChecked = e.target.checked;
                    var toggles = document.querySelectorAll('.indiv-toggle');
                    toggles.forEach(function (t) {
                      t.checked = isChecked;
                      window.handleNotificationSettingChange(t);
                    });
                  });

                  document.getElementById('iqamahToggle').addEventListener('change', function (e) {
                    if (!window.state) window.state = {};
                    if (!window.state.special) window.state.special = {};
                    window.state.special.iqamahAlert = e.target.checked;
                    if (window.__syncNativePrayerNotifications) window.__syncNativePrayerNotifications(window.state);
                  });

                  document.getElementById('jummahToggle').addEventListener('change', function (e) {
                    if (!window.state) window.state = {};
                    if (!window.state.special) window.state.special = {};
                    window.state.special.jummahAlert = e.target.checked;
                    if (window.__syncNativePrayerNotifications) window.__syncNativePrayerNotifications(window.state);
                  });

                  document.getElementById('adhkarToggle').addEventListener('change', function (e) {
                    if (!window.state) window.state = {};
                    if (!window.state.dawah) window.state.dawah = {};
                    window.state.dawah.morning = e.target.checked;
                    window.state.dawah.maghrib = e.target.checked;
                    window.state.dawah.sleep = e.target.checked;
                    if (window.__syncNativePrayerNotifications) window.__syncNativePrayerNotifications(window.state);
                  });

                                  </script>
              </div>
            </div>
          </section>
          <!-- Update App — always last -->
          <section class="settings-menu-item settings-update-item" id="settingsMenuUpdate">

            <div class="settings-menu-panel" id="settingsUpdatePanel">
              <div class="settings-menu-panel-inner">
                <div class="app-update-card" id="appUpdateCard">
                  <div class="app-update-copy">
                    <div class="app-update-title" data-i18n="settingsUpdateCardTitle">اپ ڈیٹ ایپ</div>
                    <div class="app-update-sub" id="appUpdateStatus" data-i18n="settingsUpdateCardSub">تازہ ترین ورژن
                      چیک اور اپ ڈیٹ کریں</div>
                  </div>
                  <button class="app-update-btn" id="appUpdateBtn" type="button" data-i18n="settingsUpdateBtn">اپ
                    ڈیٹ</button>
                </div>
              </div>
            </div>
          </section>

        </div>
        <div class="app-version-label" aria-label="App version">Version <span id="appVersion">1.0</span></div>
      </div>
