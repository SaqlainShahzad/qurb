                      </div>
                      <label class="notif-switch"><input type="checkbox" id="jummahToggle" data-kind="special"
                          data-key="jummahAlert" onchange="window.handleNotificationSettingChange(this)" checked><span
                          class="notif-slider"></span></label>
                    </div>

